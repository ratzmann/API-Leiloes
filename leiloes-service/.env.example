PORT=3003

# ambiente: local | dev | homol (decide se o Swagger aparece em /docs)
APP_ENV=local
# opcional: forca o Swagger ligado (true) ou desligado (false) em qualquer ambiente
# SWAGGER_ENABLED=

# banco local / docker-compose
DB_HOST=localhost
DB_PORT=5432
DB_USER=leiloes_user
DB_PASSWORD=leiloes_pass
DB_NAME=leiloes_db
# banco em nuvem (Neon/Render): a URL substitui as DB_* acima
# DATABASE_URL=postgres://usuario:senha@host/leiloes_dev?sslmode=require
# DB_SSL=true

# usuarios-service, usado pra validar o leiloeiro e liberar o credito ao cancelar
# (vazio = servico rodando sozinho: pula a validacao e a liberacao)
USUARIOS_SERVICE_URL=http://localhost:3002
# tempo maximo (ms) de espera pela resposta de outro servico
SERVICOS_TIMEOUT_MS=3000

# o mesmo segredo e emissor do auth-service: o servico confere a assinatura do
# token (jwt.verify). Sem JWT_SECRET, toda chamada COM token responde 500.
JWT_SECRET=super-segredo-trabalho-microsservicos
JWT_ISSUER=sistema-leilao-auth
