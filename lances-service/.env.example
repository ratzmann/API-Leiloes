PORT=3003

# ambiente: local | dev | homol (decide se o Swagger aparece em /docs)
APP_ENV=local
# opcional: forca o Swagger ligado (true) ou desligado (false) em qualquer ambiente
# SWAGGER_ENABLED=

# banco local / docker-compose
DB_HOST=localhost
DB_PORT=5432
DB_USER=lances_user
DB_PASSWORD=lances_pass
DB_NAME=lances_db
# banco em nuvem (Neon/Render): a URL substitui as DB_* acima
# DATABASE_URL=postgres://usuario:senha@host/lances_dev?sslmode=require
# DB_SSL=true

# Saga: o lances-service PRECISA dos outros dois (sem eles, todo lance da 503).
# Fora do Docker, ajuste as portas (leiloes e lances usam 3003 por padrao).
LEILOES_SERVICE_URL=http://localhost:3003
USUARIOS_SERVICE_URL=http://localhost:3002
SERVICOS_TIMEOUT_MS=3000
# libera o header X-Simular-Falha (so para demonstracao; deixe false em HOMOL)
SAGA_PERMITIR_FALHA_SIMULADA=false
# espera (ms) entre as tentativas do passo 4 da Saga (liberar credito do superado)
SAGA_ESPERA_REPETICAO_MS=300
