PORT=3001

# ambiente: local | dev | homol (decide se o Swagger aparece em /docs)
APP_ENV=local
# opcional: forca o Swagger ligado (true) ou desligado (false) em qualquer ambiente
# SWAGGER_ENABLED=

# banco local / docker-compose
DB_HOST=localhost
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=auth_pass
DB_NAME=auth_db
# banco em nuvem (Neon/Render): a URL substitui as DB_* acima
# DATABASE_URL=postgres://usuario:senha@host/auth_dev?sslmode=require
# DB_SSL=true

# assinatura do JWT: o MESMO segredo em todos os servicos do ambiente
JWT_SECRET=super-segredo-trabalho-microsservicos
JWT_ISSUER=sistema-leilao-auth
JWT_EXPIRES_IN=2h

# usuarios-service, onde o perfil e criado ao registrar (vazio = so cria a credencial)
USUARIOS_SERVICE_URL=http://localhost:3002
# tempo maximo (ms) de espera pela resposta de outro servico
SERVICOS_TIMEOUT_MS=3000
