PORT=3002

# ambiente: local | dev | homol (decide se o Swagger aparece em /docs)
APP_ENV=local
# opcional: forca o Swagger ligado (true) ou desligado (false) em qualquer ambiente
# SWAGGER_ENABLED=

# banco local / docker-compose
DB_HOST=localhost
DB_PORT=5432
DB_USER=usuarios_user
DB_PASSWORD=usuarios_pass
DB_NAME=usuarios_db
# banco em nuvem (Neon/Render): a URL substitui as DB_* acima
# DATABASE_URL=postgres://usuario:senha@host/usuarios_dev?sslmode=require
# DB_SSL=true

# o mesmo segredo e emissor do auth-service: o servico confere a assinatura do
# token (jwt.verify). Sem JWT_SECRET, toda chamada COM token responde 500.
JWT_SECRET=super-segredo-trabalho-microsservicos
JWT_ISSUER=sistema-leilao-auth
