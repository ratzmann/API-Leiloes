PORT=3003

# ambiente: local | dev | homol (decide se o Swagger aparece em /docs)
APP_ENV=local
# opcional: forca o Swagger ligado (true) ou desligado (false) em qualquer ambiente
# SWAGGER_ENABLED=

# banco local / docker-compose
DB_HOST=localhost
DB_PORT=5432
DB_USER=leiloes_user
DB_PASSWORD=leiloes_pass
DB_NAME=leiloes_db
# banco em nuvem (Neon/Render): a URL substitui as DB_* acima
# DATABASE_URL=postgres://usuario:senha@host/leiloes_dev?sslmode=require
# DB_SSL=true

# usuarios-service, usado pra validar o leiloeiro (vazio = servico rodando sozinho, sem validar)
USUARIOS_SERVICE_URL=http://localhost:3002
